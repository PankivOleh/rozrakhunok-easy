rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }
    function groupDoc(groupId) { return get(/databases/$(database)/documents/groups/$(groupId)); }
    function isGroupMember(groupId) { return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) && request.auth.uid in groupDoc(groupId).data.members; }
    function isCreator(groupId) { return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) && groupDoc(groupId).data.creatorId == request.auth.uid; }

    match /users/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    match /publicUsers/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(userId);
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members) && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isCreator(groupId);

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.amount is number && request.resource.data.amount > 0;
        allow update, delete: if isGroupMember(groupId) && resource.data.createdBy == request.auth.uid;
      }

      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.amount is number && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      match /debtReminders/{reminderId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.creditorId == request.auth.uid;
        allow update, delete: if isGroupMember(groupId) && resource.data.creditorId == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
    }
  }
}
