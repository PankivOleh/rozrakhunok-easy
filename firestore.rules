rules_version = '2';

// Pay & Split — Firestore Security Rules
//
// Принципи:
//  • Користувач має повний контроль лише над своїм власним документом.
//  • Групу можуть читати/писати лише її учасники.
//  • Витрати в групі видно лише учасникам цієї групи.
//  • Чутливі фінансові дії (settlements, FCM tokens) — тільки сервер (Cloud Functions).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // ---- USERS ----
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId);
      allow update: if isSelf(userId)
        // Не дозволяємо клієнту змінювати службові поля
        && !('createdAt' in request.resource.data.diff(resource.data).affectedKeys());
      // GDPR — користувач може видалити свій профіль
      allow delete: if isSelf(userId);
    }

    // ---- GROUPS ----
    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        // creatorId незмінний
        && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // ---- EXPENSES ----
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn()
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.payerId is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if isSignedIn()
        && resource.data.payerId == request.auth.uid;
    }

    // ---- SETTLEMENTS / TRANSACTIONS ----
    // Лише читання учасниками групи; запис — тільки сервер.
    match /settlements/{txId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow write: if false; // керується Cloud Functions
    }

    // ---- FCM TOKENS / приватні токени ----
    match /users/{userId}/private/{doc=**} {
      allow read, write: if false; // тільки Admin SDK
    }
  }
}
